<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Library</title>
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                Library
            </a>
            <div class="navbar-nav ms-auto">

                @* Only show these links to signed-in users *@
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="nav-link" asp-controller="Books" asp-action="Index">
                        Books
                    </a>

                    <a class="nav-link" asp-controller="Members" asp-action="Me">
                        My Profile
                    </a>

                    <a class="nav-link" asp-controller="Members" asp-action="MyLoans">
                        My Loans
                    </a>

                    @* Only Librarians see the "Add Book" link *@
                    @if (User.IsInRole("Librarian"))
                    {
                        <a class="nav-link text-warning"
                           asp-controller="Books" asp-action="Create">
                            + Add Book
                        </a>
                    }

                    <form asp-controller="Account" asp-action="Logout"
                          method="post"
                          class="d-inline">

                        @Html.AntiForgeryToken()

                        <button class="btn btn-outline-light btn-sm ms-2">
                            Sign Out
                        </button>
                    </form>
                }
                else
                {
                    <a class="nav-link"
                       asp-controller="Account"
                       asp-action="Login">

                        Sign In with Google
                    </a>
                }
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        @* Display success/error flash messages *@
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        @RenderBody()
        @RenderSection("Scripts", required: false)
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js">
    </script>
</body>
</html>