@* @model IEnumerable<LibraryManagementSystemAimanSahharon.Models.Book> *@
@model LibraryManagementSystemAimanSahharon.ViewModels.BookAvailableViewModel
@{
    ViewData["Title"] = "Book Catalog";
}

<h2>Book Catalog</h2>

@* Search/filter form — GET request so filters show in URL *@
<form method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <input type="text" name="title" value="@ViewBag.TitleFilter"
               class="form-control" placeholder="Search by title..." />
    </div>
    <div class="col-md-4">
        <input type="text" name="author" value="@ViewBag.AuthorFilter"
               class="form-control" placeholder="Search by author..." />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    </div>
    <div class="col-md-4">
        <input type="text" name="isbn" value="@ViewBag.IsbnFilter"
               class="form-control" placeholder="Search by ISBN..." />
    </div>
    <div class="col-md-3">
        <select name="sortBy" class="form-control" onchange="this.form.submit()">
            <option value="">Sort By</option>
            <option value="title_asc">Title (A → Z)</option>
            <option value="title_desc">Title (Z → A)</option>
            <option value="author_asc">Author (A → Z)</option>
            <option value="author_desc">Author (Z → A)</option>
        </select>
    </div>
</form>

@if (!Model.Books.Any())
{
    <p class="text-muted">No books found matching your search.</p>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>ISBN</th>
                <th>Year</th>
                <th>Available</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model.Books)
            {
                <tr>
                    @{
                        var alreadyBorrowed = Model.BorrowedBookIds.Contains(book.Id);
                    }
                    <td>
                        <a asp-action="Details" asp-route-id="@book.Id">@book.Title</a>
                    </td>
                    <td>@book.Author</td>
                    <td>@book.ISBN</td>
                    <td>@book.PublishedYear</td>
                    <td>
                        @if (book.AvailableCopies > 0)
                        {
                            <span class="badge bg-success">@book.AvailableCopies available</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">None available</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@book.Id"
                           class="btn btn-sm btn-outline-primary">View</a>

                        @* Borrow button *@
                       @*  @if (User.Identity?.IsAuthenticated == true && book.AvailableCopies > 0)
                        {
                            <form asp-controller="Loans" asp-action="Borrow" method="post"
                                  class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="bookId" value="@book.Id" />
                                <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Books")" />
                                <button type="submit" class="btn btn-sm btn-success">
                                    Borrow
                                </button>
                            </form>
                        } *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="Loans" asp-action="Borrow" method="post"
                                  class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="bookId" value="@book.Id" />
                                <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Books")" />

                                <button type="submit"
                                        class="btn btn-sm @(alreadyBorrowed ? "btn-secondary" : "btn-success")"
                                        @(alreadyBorrowed || book.AvailableCopies <= 0 ? "disabled" : "")>
                                    @(alreadyBorrowed ? "Borrowed" : "Borrow")
                                </button>
                            </form>
                        }
                       @*  @if (alreadyBorrowed)
                        {
                            <span class="text-warning ms-2">
                                You already borrowed this book
                            </span>
                        } *@

                        @* Edit/Delete only visible to Librarians *@
                        @if (User.IsInRole("Librarian"))
                        {
                            <a asp-action="Edit" asp-route-id="@book.Id"
                               class="btn btn-sm btn-outline-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@book.Id"
                               class="btn btn-sm btn-outline-danger">Delete</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}