@* @model LibraryManagementSystemAimanSahharon.Models.Book *@
@model LibraryManagementSystemAimanSahharon.ViewModels.BookAvailableDetailsViewModel
@{
    ViewData["Title"] = Model.Book.Title;
    var book = Model.Book;
    var isBorrowed = Model.BorrowedBookIds.Contains(book.Id);
}

<div class="card">
    <div class="card-header">
        <h3>@Model.Book.Title</h3>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.Book.Id</dd>

            <dt class="col-sm-3">Author</dt>
            <dd class="col-sm-9">@Model.Book.Author</dd>

            <dt class="col-sm-3">ISBN</dt>
            <dd class="col-sm-9">@Model.Book.ISBN</dd>

            <dt class="col-sm-3">Published</dt>
            <dd class="col-sm-9">@Model.Book.PublishedYear</dd>

            <dt class="col-sm-3">Total Copies</dt>
            <dd class="col-sm-9">@Model.Book.TotalCopies</dd>

            <dt class="col-sm-3">Available Now</dt>
            <dd class="col-sm-9">
                @if (Model.Book.AvailableCopies > 0)
                {
                    <span class="text-success fw-bold">@Model.Book.AvailableCopies</span>
                }
                else
                {
                    <span class="text-danger fw-bold">None</span>
                }
            </dd>
        </dl>

        @* Borrow button only for authenticated non-librarian users *@
        @* @if (User.Identity?.IsAuthenticated == true) 
        {
            if (Model.Book.AvailableCopies > 0)
            {
                <form asp-controller="Loans" asp-action="Borrow" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bookId" value="@Model.Book.Id" />
                    <input type="hidden" name="returnUrl" value="@Url.Action("Details", "Books", new { id = Model.Book.Id })" />
                    <button type="submit" class="btn btn-success">Borrow This Book</button>
                </form>
            }
            else
            {
                <button class="btn btn-secondary" disabled>No Copies Available</button>
            }
        } *@

        @if (User.Identity?.IsAuthenticated == true)
        {
            if (isBorrowed)
            {
                <button class="btn btn-secondary" disabled>
                    Already Borrowed
                </button>
            }
            else if (book.AvailableCopies > 0)
            {
                <form asp-controller="Loans" asp-action="Borrow" method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="bookId" value="@book.Id" />
                    <input type="hidden" name="returnUrl" value="@Url.Action("Details", "Books", new { id = book.Id })" />

                    <button type="submit" class="btn btn-success">
                        Borrow This Book
                    </button>
                </form>
            }
            else
            {
                <button class="btn btn-secondary" disabled>
                    No Copies Available
                </button>
            }
        }
    </div>
</div>

<a asp-action="Index" class="btn btn-link mt-3">← Back to Catalog</a>