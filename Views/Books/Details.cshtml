@model LibraryManagementSystemAimanSahharon.Models.Book
@{
    ViewData["Title"] = Model.Title;
}

<div class="card">
    <div class="card-header">
        <h3>@Model.Title</h3>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Author</dt>
            <dd class="col-sm-9">@Model.Author</dd>

            <dt class="col-sm-3">ISBN</dt>
            <dd class="col-sm-9">@Model.ISBN</dd>

            <dt class="col-sm-3">Published</dt>
            <dd class="col-sm-9">@Model.PublishedYear</dd>

            <dt class="col-sm-3">Total Copies</dt>
            <dd class="col-sm-9">@Model.TotalCopies</dd>

            <dt class="col-sm-3">Available Now</dt>
            <dd class="col-sm-9">
                @if (Model.AvailableCopies > 0)
                {
                    <span class="text-success fw-bold">@Model.AvailableCopies</span>
                }
                else
                {
                    <span class="text-danger fw-bold">None</span>
                }
            </dd>
        </dl>

        @* Borrow button only for authenticated non-librarian users *@
        @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Librarian"))
        {
            if (Model.AvailableCopies > 0)
            {
                <form asp-controller="Loans" asp-action="Borrow" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="bookId" value="@Model.Id" />
                    <button type="submit" class="btn btn-success">Borrow This Book</button>
                </form>
            }
            else
            {
                <button class="btn btn-secondary" disabled>No Copies Available</button>
            }
        }
    </div>
</div>

<a asp-action="Index" class="btn btn-link mt-3">← Back to Catalog</a>